			(justify left top)
		)
		(uuid "3dfea4cc-af61-4a54-8b79-b1a5b116e8bd")
	)
	(text_box "Current ripple = Ipeak/ (Fsw * (1 - D))\n\nIpeak = peak current\nFsw = switching frequency\nD = duty cycle"
		(exclude_from_sim no)
		(at 184.15 89.535 0)
		(size 45.72 13.335)
		(stroke
			(width 0)
			(type default)
